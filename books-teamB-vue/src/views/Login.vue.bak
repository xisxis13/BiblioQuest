<template>
  <div class="min-h-screen bg-background flex flex-col">
    <!-- Top Header -->
    <header class="bg-white border-b border-border py-4 px-6">
      <div class="flex items-center justify-center">
        <span class="text-2xl font-bold text-[#4A3422]">Browser</span>
      </div>
    </header>

    <!-- Login Content -->
    <div class="flex-1 flex items-center justify-center px-4 py-12">
      <div class="max-w-md w-full">
        <div class="text-center mb-8">
          <h2 class="text-4xl font-bold text-[#4A3422] mb-2">
            Bienvenue sur
          <!-- Logo -->
          <div class="mx-auto h-16 w-16 bg-orange-500 rounded-full flex items-center justify-center mb-8">
            <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          
          <p class="text-sm text-gray-600 mb-2">Pas encore de compte ? <router-link to="/register" class="text-orange-500 hover:text-orange-600">Inscris toi ici</router-link></p>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl p-8 shadow-sm">
          <form @submit.prevent="handleLogin" class="space-y-5">
            <div class="space-y-2">
              <label for="email" class="text-sm font-semibold text-[#8B4513]">Email</label>
              <input
                id="email"
                v-model="form.email"
                type="email"
                required
                class="w-full px-4 py-3 bg-[#F5F1ED] border border-border rounded-xl text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                placeholder="ex: example@mail.com"
              />
              <p v-if="emailError" class="text-sm text-destructive">{{ emailError }}</p>
            </div>

            <div class="space-y-2">
              <label for="password" class="text-sm font-semibold text-[#4A3422]">Mot de passe</label>
              <input
                id="password"
                v-model="form.password"
                type="password"
                required
                minlength="6"
                class="w-full px-4 py-3 bg-[#F5F1ED] border border-border rounded-xl text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                placeholder="ex: ••••••••"
              />
              <p v-if="passwordError" class="text-sm text-destructive">{{ passwordError }}</p>
            </div>

            <button
              type="submit"
              :disabled="authStore.isLoading"
              class="w-full bg-primary hover:bg-primary/90 text-white font-semibold py-3 rounded-xl transition-colors disabled:opacity-50 disabled:cursor-not-allowed shadow-sm"
            >
              {{ authStore.isLoading ? 'Connexion...' : 'Connexion' }}
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import { useAuthStore } from '@/stores/authStore'
import { useRouter } from 'vue-router'

export default {
  name: 'LoginPage',
  setup() {
    const authStore = useAuthStore()
    const router = useRouter()

    return {
      authStore,
      router
    }
  },
  data() {
    return {
      form: {
        email: '',
        password: ''
      },
      emailError: '',
      passwordError: ''
    }
  },
  methods: {
    validateForm() {
      this.emailError = ''
      this.passwordError = ''

      if (!this.form.email) {
        this.emailError = 'L\'email est requis'
        return false
      }

      if (!this.form.email.includes('@')) {
        this.emailError = 'Format d\'email invalide'
        return false
      }

      if (!this.form.password) {
        this.passwordError = 'Le mot de passe est requis'
        return false
      }

      if (this.form.password.length < 6) {
        this.passwordError = 'Le mot de passe doit contenir au moins 6 caractères'
        return false
      }

      return true
    },

    async handleLogin() {
      try {
        if (!this.validateForm()) return

        this.authStore.clearError()

        const result = await this.authStore.login({
          username: this.form.email,
          password: this.form.password
        })

        if (result.success) {
          this.router.push('/library')
        }
      } catch (error) {
        console.error('Erreur dans handleLogin:', error)
      }
    }
  },

  mounted() {
    if (this.authStore.isAuthenticated) {
      this.router.push('/library')
    }
  }
}
</script>
